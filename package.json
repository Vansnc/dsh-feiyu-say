{
  "name": "dsh-feiyu-say",
  "version": "0.6.1",
  "description": "阿里百炼 TTS（WebSocket）合成语音，输出 WAV 并可在线试听；不依赖本地模型。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tts",
    "voice",
    "dashscope",
    "bailian",
    "qwen-tts"
  ],
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-say.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-say#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-say/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
